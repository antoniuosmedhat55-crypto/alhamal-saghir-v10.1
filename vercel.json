{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "bundle-chunks/**",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/attendance-close",
      "schedule": "0 14 * * 0-4"
    },
    {
      "path": "/api/cron/attendance-close",
      "schedule": "0 15 * * 0-4"
    }
  ]
}
